local T = require("./TestKit")
local StudMath = require("../src/shared/StudMath")

T.describe("StudMath", function()
	T.it("finds the face that points up", function()
		T.eq(StudMath.upFace(0, 1, 0), "Top")
		T.eq(StudMath.upFace(0, -1, 0), "Bottom")
		-- A wedge rolled 90 degrees (like the island's GrassTop): its right side looks up.
		T.eq(StudMath.upFace(1, 0, 0), "Right")
		T.eq(StudMath.upFace(-1, 0, 0), "Left")
		T.eq(StudMath.upFace(0, 0, 1), "Front")
		T.eq(StudMath.upFace(0, 0, -1), "Back")
	end)
	T.it("skips walls and steep tilts", function()
		T.eq(StudMath.upFace(0, 0, 0), nil)
		T.eq(StudMath.upFace(0.5, 0.6, 0.6), nil)
	end)
	T.it("vivid keeps greys grey and pushes colour", function()
		local r, g, b = StudMath.vivid(0.5, 0.5, 0.5, 1.25, 1)
		T.near(r, 0.5)
		T.near(g, 0.5)
		T.near(b, 0.5)
		-- Island grass 70c852: greener, same hue order.
		local r2, g2, b2 = StudMath.vivid(0x70 / 255, 0xc8 / 255, 0x52 / 255, 1.25, 1)
		T.truthy(g2 >= 0xc8 / 255 - 1e-6 and r2 < 0x70 / 255 and b2 < 0x52 / 255, "more saturated")
	end)
	T.it("vivid with 1, 1 is a no-op", function()
		local r, g, b = StudMath.vivid(0.9, 0.2, 0.4, 1, 1)
		T.near(r, 0.9)
		T.near(g, 0.2)
		T.near(b, 0.4)
	end)
end)

return nil
