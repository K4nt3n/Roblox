local T = require("./TestKit")
local Config = require("../src/shared/Config")
local FairMath = require("../src/shared/FairMath")

local F = Config.Fair

T.describe("FairMath", function()
	T.it("week ids roll over exactly at the anchor boundary", function()
		local start = FairMath.weekStartsAt(100, F)
		T.eq(FairMath.weekId(start, F), 100)
		T.eq(FairMath.weekId(start - 1, F), 99)
		T.eq(FairMath.weekId(FairMath.weekEndsAt(100, F) - 1, F), 100)
		T.eq(FairMath.secondsUntilRollover(start, F), F.weekSeconds)
	end)
	T.it("converts weights to integer gram scores and back", function()
		T.eq(FairMath.weightToScore(12.3456), 12345)
		T.near(FairMath.scoreToWeight(12345), 12.345)
	end)
	T.it("maps ranks to tiers", function()
		T.eq(FairMath.tierForRank(1, F.rewardTiers).id, "blue")
		T.eq(FairMath.tierForRank(10, F.rewardTiers).id, "blue")
		T.eq(FairMath.tierForRank(11, F.rewardTiers).id, "red")
		T.eq(FairMath.tierForRank(nil, F.rewardTiers).id, "entrant")
	end)
	T.it("division tiers give nothing outside the top ten", function()
		T.eq(FairMath.tierForRank(1, F.divisionTiers).id, "blue")
		T.eq(FairMath.tierForRank(3, F.divisionTiers).id, "red")
		T.eq(FairMath.tierForRank(10, F.divisionTiers).id, "yellow")
		T.eq(FairMath.tierForRank(11, F.divisionTiers), nil)
		T.eq(FairMath.tierForRank(nil, F.divisionTiers), nil)
		T.eq(FairMath.deepestRank(F.divisionTiers), 10)
		T.eq(FairMath.deepestRank(F.rewardTiers), 1000)
	end)
	T.it("finds finished, unclaimed periods oldest first, across maps", function()
		local entries = { ["5"] = {}, ["3"] = {}, ["7"] = {}, ["8"] = {} }
		local claimed = { ["3"] = true }
		local helper = { ["6"] = 4, ["5"] = 1 }
		local ids = FairMath.unclaimedPeriods(entries, claimed, 8, helper)
		T.eq(#ids, 3)
		T.eq(ids[1], 5)
		T.eq(ids[2], 6)
		T.eq(ids[3], 7)
	end)
end)

T.describe("FairMath periods", function()
	local P = F.periods
	T.it("the weekly period matches the week id", function()
		local now = F.weekAnchorUnix + 123456789
		T.eq(FairMath.periodId(now, P.weekly), FairMath.weekId(now, F))
	end)
	T.it("period ids roll over exactly at the boundary", function()
		for _, period in P do
			local start = FairMath.periodStartsAt(40, period)
			T.eq(FairMath.periodId(start, period), 40, period.id)
			T.eq(FairMath.periodId(start - 1, period), 39, period.id)
			T.eq(FairMath.periodEndsAt(40, period) - start, period.seconds, period.id)
		end
	end)
	T.it("the hourly fair never rolls over at the same moment as the daily one", function()
		local dailyStart = FairMath.periodStartsAt(100, P.daily)
		T.truthy(FairMath.periodId(dailyStart, P.hourly) == FairMath.periodId(dailyStart - 1, P.hourly))
	end)
	T.it("sorts periods hourly, daily, weekly", function()
		local list = FairMath.sortedPeriods(P)
		T.eq(list[1].id, "hourly")
		T.eq(list[2].id, "daily")
		T.eq(list[3].id, "weekly")
	end)
	T.it("show phase: announce before rollover, live right after, idle otherwise", function()
		local period = P.daily
		local rollover = FairMath.periodStartsAt(200, period)
		local phase, id, at = FairMath.showPhase(rollover - 10, period)
		T.eq(phase, "Announce")
		T.eq(id, 199)
		T.eq(at, rollover)
		phase, id, at = FairMath.showPhase(rollover + 5, period)
		T.eq(phase, "Live")
		T.eq(id, 199)
		T.eq(at, rollover)
		phase = FairMath.showPhase(rollover + period.show.liveWindowSeconds + 1, period)
		T.eq(phase, "Idle")
		phase = FairMath.showPhase(rollover - period.show.announceSeconds - 1, period)
		T.eq(phase, "Idle")
	end)
	T.it("every show fits inside its live window", function()
		for _, period in P do
			local s = period.show
			local longest = s.gatherSeconds + s.weighSecondsPerEntry * s.maxStageEntries + s.awardsSeconds + s.globalSeconds
			T.truthy(longest <= s.liveWindowSeconds, period.id .. " show is longer than its window")
		end
	end)
end)

T.describe("FairMath divisions", function()
	local pumpkin = { cropId = "pumpkin", weight = 30 }
	local function ids(list)
		local set = {}
		for _, d in list do
			set[d.id] = d.score
		end
		return set
	end
	T.it("every entry is in overall and its crop board", function()
		local set = ids(FairMath.divisionsForEntry(pumpkin, {}))
		T.eq(set.overall, 30000)
		T.eq(set.crop_pumpkin, 30000)
		T.eq(set.firstTimer, nil)
		T.eq(set.natural, nil)
	end)
	T.it("first-timers, most improved, natural grown and team", function()
		local champ = { cropId = "pumpkin", weight = 30, isChampion = true, paidSkips = 0, coGrowers = { 1 } }
		local set = ids(FairMath.divisionsForEntry(champ, { isFirstTimer = true, previousBest = 20 }))
		T.eq(set.firstTimer, 30000)
		T.eq(set.improved, 1500)
		T.eq(set.natural, 30000)
		T.eq(set.team, 30000)
	end)
	T.it("a paid skip leaves Natural Grown; no improvement leaves Most Improved", function()
		local champ = { cropId = "pumpkin", weight = 30, isChampion = true, paidSkips = 1 }
		local set = ids(FairMath.divisionsForEntry(champ, { previousBest = 40 }))
		T.eq(set.natural, nil)
		T.eq(set.improved, nil)
		T.eq(set.team, nil)
	end)
	T.it("each fair only judges its own divisions", function()
		local champ = { cropId = "pumpkin", weight = 30, isChampion = true, paidSkips = 0 }
		local hourly = ids(FairMath.divisionsForEntry(champ, { isFirstTimer = true }, F.periods.hourly.divisions))
		T.eq(hourly.overall, 30000)
		T.eq(hourly.crop_pumpkin, nil)
		T.eq(hourly.natural, nil)
		local daily = ids(FairMath.divisionsForEntry(champ, { isFirstTimer = true }, F.periods.daily.divisions))
		T.eq(daily.crop_pumpkin, 30000)
		T.eq(daily.firstTimer, nil)
		local weekly = ids(FairMath.divisionsForEntry(champ, { isFirstTimer = true }, F.periods.weekly.divisions))
		T.eq(weekly.natural, 30000)
		T.eq(weekly.firstTimer, 30000)
	end)
	T.it("names divisions for players", function()
		T.eq(FairMath.divisionName("crop_pumpkin", F.divisions, Config.Crops), "Best " .. Config.Crops.pumpkin.displayName)
		T.eq(FairMath.divisionName("natural", F.divisions, Config.Crops), "Natural Grown")
	end)
end)

T.describe("FairMath ribbons and stage", function()
	T.it("ribbon ids round-trip", function()
		local id = FairMath.ribbonId("weekly", "Blue", "crop_pumpkin")
		T.eq(id, "weekly:Blue:crop_pumpkin")
		local fair, tier, division = FairMath.parseRibbonId(id)
		T.eq(fair, "weekly")
		T.eq(tier, "Blue")
		T.eq(division, "crop_pumpkin")
		T.eq(FairMath.parseRibbonId("OldRibbon"), nil)
	end)
	T.it("stage order is lightest first and keeps the heaviest", function()
		local entries = { { weight = 5 }, { weight = 1 }, { weight = 9 }, { weight = 3 } }
		local order = FairMath.stageOrder(entries, 3)
		T.eq(#order, 3)
		T.eq(order[1].weight, 3)
		T.eq(order[3].weight, 9)
		T.eq(#entries, 4)
	end)
end)

return nil
