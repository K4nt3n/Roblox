local T = require("./TestKit")
local Config = require("../src/shared/Config")
local GrowthMath = require("../src/shared/GrowthMath")

local carrot = Config.Crops.carrot
local pumpkin = Config.Crops.pumpkin

local function plant(crop, now, speed)
	-- rollSize 0.5 => sizeRoll exactly 1; rollGene 0.99 => no gene.
	return GrowthMath.newPlant(crop, Config.Growth, now, speed or 1, 1, 0.5, 0.99)
end

T.describe("GrowthMath.newPlant", function()
	T.it("rolls neutral size at 0.5 and respects gene chance", function()
		local p = plant(carrot, 1000)
		T.near(p.sizeRoll, 1)
		T.eq(p.gene, false)
		local lucky = GrowthMath.newPlant(carrot, Config.Growth, 0, 1, 1, 0, 0.0)
		T.eq(lucky.gene, true)
		T.near(lucky.sizeRoll, 1 - carrot.variance)
	end)
	T.it("Green Thumb multiplier widens the gene chance", function()
		local roll = Config.Growth.baseGiantGeneChance * 1.5 -- just above base chance
		T.eq(GrowthMath.newPlant(carrot, Config.Growth, 0, 1, 1, 0.5, roll).gene, false)
		T.eq(GrowthMath.newPlant(carrot, Config.Growth, 0, 1, 2, 0.5, roll).gene, true)
	end)
end)

T.describe("GrowthMath.evaluate", function()
	T.it("starts as a Seed with a small non-zero weight", function()
		local p = plant(carrot, 0)
		local s = GrowthMath.evaluate(p, carrot, Config, 0)
		T.eq(s.stage, "Seed")
		T.near(s.weight, carrot.ripeWeight * 0.05)
		T.eq(s.canHarvest, false)
		T.near(s.secondsToRipe, carrot.growSeconds)
	end)
	T.it("walks through stages in order", function()
		local p = plant(carrot, 0)
		local g = carrot.growSeconds
		T.eq(GrowthMath.evaluate(p, carrot, Config, g * 0.2).stage, "Sprout")
		T.eq(GrowthMath.evaluate(p, carrot, Config, g * 0.5).stage, "Growing")
		T.eq(GrowthMath.evaluate(p, carrot, Config, g).stage, "Ripe")
		T.eq(GrowthMath.evaluate(p, carrot, Config, g + carrot.giantSeconds * 0.6).stage, "Giant")
	end)
	T.it("is exactly ripe weight at ripe and capped at giant multiplier", function()
		local p = plant(pumpkin, 0)
		T.near(GrowthMath.evaluate(p, pumpkin, Config, pumpkin.growSeconds).weight, pumpkin.ripeWeight)
		local maxed = GrowthMath.evaluate(p, pumpkin, Config, 10 ^ 9)
		T.near(maxed.weight, pumpkin.ripeWeight * pumpkin.giantMultiplier)
		T.eq(maxed.isMaxed, true)
	end)
	T.it("keeps growing offline: state depends only on timestamps", function()
		local p = plant(pumpkin, 1000)
		-- Player leaves for 5 hours; nothing ticks, the result is still correct.
		local later = GrowthMath.evaluate(p, pumpkin, Config, 1000 + 5 * 3600)
		T.eq(later.canHarvest, true)
		T.truthy(later.weight > pumpkin.ripeWeight)
	end)
	T.it("weight never decreases over time", function()
		local p = plant(carrot, 0)
		local last = 0
		for t = 0, carrot.growSeconds + carrot.giantSeconds + 60, 7 do
			local w = GrowthMath.evaluate(p, carrot, Config, t).weight
			T.truthy(w >= last - 1e-9, "weight dropped at t=" .. t)
			last = w
		end
	end)
	T.it("fertilizer speed shortens real time to ripe", function()
		local p = plant(carrot, 0, 1.5)
		local s = GrowthMath.evaluate(p, carrot, Config, 0)
		T.near(s.secondsToRipe, carrot.growSeconds / 1.5)
	end)
	T.it("ignores clocks earlier than plantedAt", function()
		local p = plant(carrot, 500)
		T.near(GrowthMath.effectiveElapsed(p, 100), 0)
	end)
end)

T.describe("GrowthMath watering", function()
	T.it("adds boost, weight bonus, and starts cooldown", function()
		local p = plant(pumpkin, 0)
		local before = GrowthMath.evaluate(p, pumpkin, Config, 0)
		local ok = GrowthMath.canWater(p, pumpkin, Config, 0)
		T.eq(ok, true)
		local boost = GrowthMath.applyWater(p, pumpkin, Config, 1, 1)
		T.near(boost, math.clamp(pumpkin.growSeconds * Config.Watering.boostFraction, Config.Watering.minBoostSeconds, Config.Watering.maxBoostSeconds))
		local after = GrowthMath.evaluate(p, pumpkin, Config, 0)
		T.truthy(after.weight > before.weight)
		T.near(after.secondsToRipe, before.secondsToRipe - boost)
		local ok2, reason, wait = GrowthMath.canWater(p, pumpkin, Config, 10)
		T.eq(ok2, false)
		T.eq(reason, "Cooldown")
		T.near(wait, Config.Watering.plantCooldownSeconds - 9)
	end)
	T.it("clamps boost to min and max", function()
		local tiny = { growSeconds = 1 }
		T.eq(GrowthMath.waterBoostSeconds(tiny, Config.Watering, 1), Config.Watering.minBoostSeconds)
		local huge = { growSeconds = 10 ^ 9 }
		T.eq(GrowthMath.waterBoostSeconds(huge, Config.Watering, 1), Config.Watering.maxBoostSeconds)
	end)
	T.it("caps the weight bonus", function()
		local p = plant(carrot, 0)
		p.waterCount = 999
		T.near(GrowthMath.waterWeightMultiplier(p, Config.Watering), 1 + Config.Watering.maxWaterBonusCount * Config.Watering.weightBonusPerWater)
	end)
	T.it("refuses to water a maxed crop", function()
		local p = plant(carrot, 0)
		local ok, reason = GrowthMath.canWater(p, carrot, Config, 10 ^ 9)
		T.eq(ok, false)
		T.eq(reason, "Maxed")
	end)
end)

T.describe("GrowthMath skip", function()
	T.it("makes the crop ripe immediately", function()
		local p = plant(pumpkin, 0)
		GrowthMath.applySkip(p, pumpkin, 60)
		local s = GrowthMath.evaluate(p, pumpkin, Config, 60)
		T.eq(s.canHarvest, true)
		T.near(s.weight, pumpkin.ripeWeight)
		T.near(GrowthMath.skipSecondsNeeded(p, pumpkin, 60), 0)
	end)
end)

return nil
