local T = require("./TestKit")
local Format = require("../src/shared/Format")

T.describe("Format", function()
	T.it("coins", function()
		T.eq(Format.coins(950), "950")
		T.eq(Format.coins(1234), "1,234")
		T.eq(Format.coins(12500), "12.5K")
		T.eq(Format.coins(3400000), "3.4M")
		T.eq(Format.coins(20000), "20K")
		T.eq(Format.coins(250000), "250K")
	end)
	T.it("weight", function()
		T.eq(Format.weight(0.42), "0.42 kg")
		T.eq(Format.weight(12.34), "12.3 kg")
		T.eq(Format.weight(1234.5), "1,235 kg")
	end)
	T.it("duration", function()
		T.eq(Format.duration(45), "45s")
		T.eq(Format.duration(125), "2m 05s")
		T.eq(Format.duration(3720), "1h 02m")
		T.eq(Format.duration(90000), "1d 1h")
		T.eq(Format.duration(-5), "0s")
	end)
end)

return nil
